{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5101",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "OtpDb": "Data Source=otp.db"
  },
  "Otp": {
    "CodeLength": 6,
    "ExpirySeconds": 120,
    "MaxAttemptsPerOtp": 5,
    "IdentifierFailureThreshold": 10,
    "IdentifierFreezeSeconds": 900,
    "HmacSecret": "dev-only-secret-not-for-production",
    "ReturnCodeInResponse": true
  }
}
